// 本機 emulator 用：照正式兩個 bucket（預設、asia-east1）目前實際部署的 Storage ruleset（2026-03-06 版，指揮官 2026-10-22 以 Rules REST API 唯讀查證）。
// 不是 FC repo 的 storage.rules：repo 版（5d3afd302）對 Path 呼叫 matches，部署即壞、從未部署，修正另案 T-015。
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // T-089 新站賽事卡片圖片：照 FC 分支 t-089-rules 的 storage.rules 同名區塊（尚未部署，部署是 GATED）。
    // 判斷靠跨服務讀 Firestore（users／rolePermissions／userPermissionGrants），emulator 要 firestore 一起開。
    function storageAuthRole() {
      let userPath = /databases/(default)/documents/users/$(request.auth.uid);
      let docRole = firestore.exists(userPath) && firestore.get(userPath).data.get('role', '') is string
        ? firestore.get(userPath).data.get('role', '')
        : '';
      return docRole != ''
        ? docRole
        : ((('role' in request.auth.token) && request.auth.token.role is string)
          ? request.auth.token.role
          : 'user');
    }

    function storageHasRolePerm(role, perm) {
      let rpPath = /databases/(default)/documents/rolePermissions/$(role);
      return role != 'user'
        && firestore.exists(rpPath)
        && firestore.get(rpPath).data.get('permissions', null) is list
        && perm in firestore.get(rpPath).data.get('permissions', []);
    }

    function storageHasUserGrant(perm) {
      let grantPath = /databases/(default)/documents/userPermissionGrants/$(request.auth.uid);
      return firestore.exists(grantPath)
        && firestore.get(grantPath).data.get('permissions', null) is list
        && firestore.get(grantPath).data.get('enabled', true) == true
        && perm in firestore.get(grantPath).data.get('permissions', []);
    }

    function isTournamentCardManager() {
      let role = storageAuthRole();
      return role == 'super_admin'
        || storageHasRolePerm(role, 'admin.tournaments.entry')
        || storageHasUserGrant('admin.tournaments.entry');
    }

    match /tournamentCards/{cardId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && isTournamentCardManager();
      allow delete: if request.auth != null
        && isTournamentCardManager();
    }
  }
}
