# ── LINE LIFF ──────────────────────────────────────────
# LIFF ID（從 LINE Developers Console 取得）。
# 正式部署請由外部注入；不得 commit 實值到 repo。
VITE_LIFF_ID=

# ── Firebase Emulator ──────────────────────────────────
# 0 = 關閉（預設，連正式服務）
# 1 = 開啟（僅 dev 生效；vite build 的 PROD 建置一律忽略此旗標）
VITE_FIREBASE_EMULATOR=0

# ── Callable 呼叫模式 ──────────────────────────────────
# live = 連 Cloud Functions（正式）
# mock = 走 registerMock 註冊的假實作（僅供測試／離線開發）
VITE_CALLABLE_MODE=live

# 內測模式：正式建置不設 VITE_PUBLIC_LAUNCH 就是內測模式（角落浮水印＋noindex）。
# 2026-10-20 起不再有白名單閘門與寫入限制。正式上線才設 1。詳見 docs/handover.md 4.1。
VITE_PUBLIC_LAUNCH=
