{
  "name": "fc-b",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "npm run typecheck && npm run test && npm run check:i18n",
    "emulators": "firebase emulators:start --only firestore,auth --config emulator/firebase.json",
    "sync:rules": "node scripts/sync-rules.mjs",
    "check:rules-sync": "node scripts/check-rules-sync.mjs",
    "check:parity": "node scripts/check-permission-parity.mjs ../FC",
    "seed:emulator": "node scripts/seed-emulator.mjs --reset",
    "e2e:shots": "node scripts/e2e-shots.mjs e2e-out"
  },
  "dependencies": {
    "@line/liff": "^2.31.2",
    "barcode-detector": "^3.2.2",
    "firebase": "^12.19.0",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "firebase-tools": "^14.8.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^5.0.5",
    "workbox-window": "7.4.1"
  }
}
